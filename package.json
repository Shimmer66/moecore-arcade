{
  "name": "moecore-arcade",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "pnpm --filter @moecore/web run dev",
    "build": "pnpm --filter @moecore/web run build",
    "preview": "pnpm --filter @moecore/web run preview",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "test:match3": "pnpm --filter @moecore/game-match3 run test",
    "test:e2e": "pnpm --filter @moecore/web run test:e2e",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check": "pnpm run check:workspace && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
